  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @app/api",
    "dev:web": "npm run dev -w @app/web",
    "build": "npm run build -w @app/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "sh scripts/check-boundaries.sh",
    "check:annotated": "node scripts/check-annotated.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm run check:annotated",
    "deploy:api": "npm run deploy -w @app/api"
  },
