write_file scripts/check-boundaries.sh <<'EOF'
#!/usr/bin/env sh
# Fails if the onion layering is violated:
#   domain -> imports nothing from apps or frameworks
#   api    -> must not import web
#   web    -> must not import api
# Works from any directory: paths are derived from this script's location.
set -eu

root="$(dirname "$0")/.."
status=0

# check <dir> <extended-regex> <message>
check() {
  if matches=$(grep -rEn --include='*.ts' "$2" "$1" 2>/dev/null); then
    echo "Boundary violation: $3" >&2
    echo "$matches" >&2
    status=1
  fi
}

check "$root/packages/domain/src" "from ['\"](@app/(api|web)|hono|vite|@cloudflare)" \
  "domain must not import apps or frameworks"
check "$root/apps/api/src" "from ['\"]@app/web" "api must not import web"
check "$root/apps/web/src" "from ['\"]@app/api" "web must not import api"

if [ "$status" -eq 0 ]; then
  echo "Layer boundaries OK." >&2
fi
exit "$status"
EOF

write_file scripts/check-annotated.mjs <<'EOF'
// Verifies that every X.annotated.jsonc matches its sibling X.json once
// whole-line // comments are removed. Comments must be on their own lines.
// Works from any directory: paths are derived from this script's location.
import { readFileSync, readdirSync } from "node:fs";
import { join, dirname, relative } from "node:path";
import { fileURLToPath } from "node:url";
import { isDeepStrictEqual } from "node:util";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const skip = new Set(["node_modules", ".git", "dist", ".wrangler"]);

function* walk(dir) {
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    if (skip.has(entry.name)) continue;
    const full = join(dir, entry.name);
    if (entry.isDirectory()) yield* walk(full);
    else yield full;
  }
}

const stripComments = (text) =>
  text
    .split("\n")
    .filter((line) => !/^\s*\/\//.test(line))
    .join("\n");

let checked = 0;
let failed = false;

for (const file of walk(root)) {
  if (!file.endsWith(".annotated.jsonc")) continue;
  checked += 1;
  const realFile = file.replace(/\.annotated\.jsonc$/, ".json");
  const shown = relative(root, file);
  try {
    const annotated = JSON.parse(stripComments(readFileSync(file, "utf8")));
    const real = JSON.parse(readFileSync(realFile, "utf8"));
    if (!isDeepStrictEqual(annotated, real)) {
      console.error(`DRIFT: ${shown} differs from ${relative(root, realFile)}`);
      failed = true;
    }
  } catch (err) {
    console.error(`ERROR: ${shown}: ${err.message}`);
    failed = true;
  }
}

if (failed) process.exit(1);
console.error(`Annotated companions OK (${checked} checked).`);
EOF

write_file README.md <<'EOF'
# Web App Monorepo

npm workspaces monorepo targeting Cloudflare, developed on Debian stable.

| Path | Role |
|---|---|
| `packages/domain` | Fresh Onion core. Pure TypeScript, no runtime dependencies, no I/O, no clock or framework access. |
| `apps/api` | Transport layer: Hono on Cloudflare Workers. |
| `apps/web` | Vite frontend. |

## Rules

- `domain` imports nothing from `api`, `web`, Hono, Vite or Cloudflare. Time and other effects are passed in as arguments.
- `api` and `web` may import `domain`, never each other.
- `npm run check:boundaries` enforces this; `npm run check` also type-checks every package and verifies the annotated companions.
- `domain` is consumed as TypeScript source (`exports` points at `src/index.ts`), so there is no build step for it.

## Commented JSON

- `tsconfig*.json` files carry real `//` comments (TypeScript allows them).
- `package.json` cannot hold comments, so each has a companion `package.annotated.jsonc` with the same content plus `//` comments. Edit both together; `npm run check:annotated` fails if they drift apart. Comments must stay on their own lines.

## Setup

Requires Node >= 20.19 (see `.nvmrc` and `engines`). Use a single Node source: either Debian's packaged Node or an upstream one (NodeSource, nvm), not both. Avoid running `npm install -g npm@latest` over a dpkg-managed Node.

    npm install
    npm run dev:api     # Wrangler dev server on :8787
    npm run dev:web     # Vite dev server on :3000, proxies /api to :8787

## Deploy

    npx wrangler login
    npm run deploy:api

Deploying the web app is not set up yet. Decide between Cloudflare Workers static assets and Pages, then add a script.

## Notes

- `apps/api/wrangler.toml`: `compatibility_date` is a deliberate setting. Review the Workers changelog before changing it, and test on a preview deployment first.
- The dependency version ranges in the package.json files were chosen when this template was written. Run `npm outdated` and check release notes before relying on them.
- Commit `package-lock.json` after the first `npm install`.
EOF

