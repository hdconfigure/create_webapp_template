write_file apps/web/src/main.ts <<'EOF'
import { createGreeting } from "@app/domain";

const root = document.getElementById("app");

if (root) {
  const data = createGreeting("Frontend User", new Date());

  const wrapper = document.createElement("div");
  wrapper.style.cssText =
    "font-family: system-ui, sans-serif; padding: 2rem; max-width: 600px; margin: auto;";

  const heading = document.createElement("h1");
  heading.textContent = data.message;

  const stamp = document.createElement("p");
  const small = document.createElement("small");
  small.textContent = `Timestamp: ${data.timestamp}`;
  stamp.appendChild(small);

  wrapper.append(heading, stamp);
  root.replaceChildren(wrapper);
}
EOF

