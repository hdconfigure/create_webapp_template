# create_webapp_repo.sh
#
# Scaffolds an npm-workspaces monorepo:
#   packages/domain  Fresh Onion core: pure TypeScript, zero runtime dependencies
#   apps/api         Hono on Cloudflare Workers (transport layer)
#   apps/web         Vite frontend
#
# Design notes:
#   - This script never changes directory. Every path is built from the target
#     directory argument, and git is pointed at it with "git init <dir>".
#   - All messages (errors and status) go to stderr; stdout is left empty.
#     The generated check scripts follow the same convention.
#   - The domain package exports its TypeScript source directly. Vite and
#     Wrangler (esbuild) both compile it, so there is no separate build step.
#   - Comments in JSON:
#       * tsconfig*.json files accept real // comments, so they are annotated
#         inline. ("_comment_" keys there are a TS5023 compile error.)
#       * package.json cannot carry comments, and "_comment_" keys inside
#         dependencies/devDependencies make npm try to install them as
#         packages. Each package.json therefore gets an annotated companion,
#         package.annotated.jsonc, and scripts/check-annotated.mjs verifies the
#         companion still matches the real file.
#   - Local packages are referenced as "*" (npm workspaces link them);
#     the "workspace:" protocol is pnpm/yarn only.
#
# Usage: create_webapp_repo.sh <target_directory>

set -eu

# --- Preconditions -----------------------------------------------------------

if [ -z "${1:-}" ]; then
  echo "Error: Target directory argument is required." >&2
  echo "Usage: $0 <target_directory>" >&2
  exit 1
fi

TARGET_DIR="$1"

if ! command -v git >/dev/null 2>&1; then
  echo "Error: git is required but was not found (Debian: sudo apt-get install git)." >&2
  exit 1
fi

if [ -f "$TARGET_DIR/.app_initialized" ] || [ -f "$TARGET_DIR/package.json" ]; then
  echo "WARNING: '$TARGET_DIR' already looks initialized (.app_initialized or package.json exists)." >&2
  echo "Aborting to prevent overwriting existing work." >&2
  exit 1
fi

# --- Helper ------------------------------------------------------------------

# write_file <relative_path>   (file content is read from stdin)
write_file() {
  dest="$TARGET_DIR/$1"
  if ! mkdir -p "$(dirname "$dest")" || ! cat > "$dest"; then
    echo "Error: Failed to write '$dest'." >&2
    exit 1
  fi
}

mkdir -p "$TARGET_DIR/apps/web/src" \
         "$TARGET_DIR/apps/api/src" \
         "$TARGET_DIR/packages/domain/src" \
         "$TARGET_DIR/scripts" || {
  echo "Error: Failed to create directory structure in '$TARGET_DIR'." >&2
  exit 1
}

# --- Root --------------------------------------------------------------------

