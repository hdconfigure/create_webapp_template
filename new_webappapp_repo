{
  "compilerOptions": {
    // JavaScript language version the code is written against
    "target": "ES2022",
    // Module syntax; the bundlers (Vite, Wrangler/esbuild) handle output
    "module": "ESNext",
    // Resolve imports the way modern bundlers do (honors package "exports")
