write_file packages/domain/src/index.ts <<'EOF'
export interface Greeting {
  message: string;
  timestamp: string;
}

/**
 * Pure domain function: the current time is an input, not something the
 * domain reaches out and grabs, so this is deterministic and easy to test.
 */
export function createGreeting(name: string, now: Date): Greeting {
  const safeName = name.trim() === "" ? "World" : name.trim().slice(0, 100);
  return {
    message: `Hello, ${safeName}! Powered by Fresh Onion architecture.`,
    timestamp: now.toISOString(),
  };
}
EOF

