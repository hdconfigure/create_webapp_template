install_hd_tool hdconfigure create_webapp_template
cat_webapp_tools() {
    # Ensure at least a directory and one file are provided
    if [ "$#" -lt 2 ]; then
        echo "Usage: cat_webapp_tools <directory> <file1> [file2 ...]" >&2
        return 1
    }

    local dir="$1"
    shift

    for file in "$@"; do
        cat "$dir/$file"
    done
}
cat_webapp_tools "$HOME/.configure/hdconfigure/tools" install_webapp_dependencies create_new_webapp_repo test_new_weapp_repo scaffold_webapp_edge deploy_webapp_edge
