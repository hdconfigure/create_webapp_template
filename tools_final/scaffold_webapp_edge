# scaffold_webapp_edge.sh
#
# Verifies that Cloudflare's Wrangler CLI is available and actually runs. It
# looks for a project-local Wrangler first (the monorepo's apps/api
# devDependency, usually hoisted to the root node_modules), then a global one.
# This script installs nothing: if Node.js or Wrangler is missing it prints an
# error to stderr and exits 1. Run install_webapp_dependencies.sh to install
# them.
#
# Design notes:
#   - This script never changes directory. Wrangler is run by its path.
#   - All messages (errors and status) go to stderr, and so does the output of
#     the tools it runs (wrangler), so stdout is left empty.
#   - Any failure exits with a non-zero status (set -eu plus explicit checks).
#   - Unlike a check that only looks for a file, this script runs
#     "wrangler --version" at the end, so a broken or incompatible install is
#     reported instead of passing silently.
#   - The minimum Node version is read from the project's .nvmrc, with the
#     defaults below as a fallback (same rule as install_webapp_dependencies.sh).
#   - This script writes no files of its own, so there is nothing to annotate
#     and no companion files are needed.
#
# Usage: scaffold_webapp_edge.sh [target_directory]   (default: current directory)

set -eu

# Fallback minimum Node version, used only when .nvmrc cannot be read.
DEFAULT_NODE_MAJOR=20
DEFAULT_NODE_MINOR=19

TARGET_DIR="${1:-.}"
WRANGLER_BIN=""

# --- Helpers -----------------------------------------------------------------

# say <message>: status message to stderr
say() {
  echo "$@" >&2
}

# die <message>: error message to stderr, then exit with failure
die() {
  echo "Error: $*" >&2
  exit 1
}

# is_number <string>: succeeds if the string is a non-empty run of digits
is_number() {
  case "$1" in
    '' | *[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

# find_wrangler: sets WRANGLER_BIN to the Wrangler to use (project-local first,
# then global). Returns non-zero, with WRANGLER_BIN empty, if none is found.
find_wrangler() {
  for candidate in \
    "$TARGET_DIR/node_modules/.bin/wrangler" \
    "$TARGET_DIR/apps/api/node_modules/.bin/wrangler"
  do
    if [ -x "$candidate" ]; then
      WRANGLER_BIN="$candidate"
      return 0
    fi
  done
  if WRANGLER_BIN="$(command -v wrangler 2>/dev/null)"; then
    return 0
  fi
  WRANGLER_BIN=""
  return 1
}

# --- Preconditions -----------------------------------------------------------

[ -d "$TARGET_DIR" ] || die "Target directory '$TARGET_DIR' does not exist."

command -v node >/dev/null 2>&1 ||
  die "node is required but was not found. Run install_webapp_dependencies.sh first."

# Minimum Node version: from .nvmrc ("20.19", "v20.19.2" or "20"), else defaults
min_major="$DEFAULT_NODE_MAJOR"
min_minor="$DEFAULT_NODE_MINOR"
if [ -f "$TARGET_DIR/.nvmrc" ]; then
  nvmrc_line=""
  IFS= read -r nvmrc_line < "$TARGET_DIR/.nvmrc" || true
  nvmrc_version="${nvmrc_line#v}"
  nvmrc_major="${nvmrc_version%%.*}"
  case "$nvmrc_version" in
    *.*) nvmrc_rest="${nvmrc_version#*.}"; nvmrc_minor="${nvmrc_rest%%.*}" ;;
    *) nvmrc_minor=0 ;;
  esac
  if is_number "$nvmrc_major" && is_number "$nvmrc_minor"; then
    min_major="$nvmrc_major"
    min_minor="$nvmrc_minor"
  else
    say "Warning: could not parse '$TARGET_DIR/.nvmrc'; requiring Node >= $min_major.$min_minor."
  fi
fi

node_version="$(node --version)" || die "Could not run 'node --version'."
version_digits="${node_version#v}"
node_major="${version_digits%%.*}"
version_rest="${version_digits#*.}"
node_minor="${version_rest%%.*}"

if ! is_number "$node_major" || ! is_number "$node_minor"; then
  die "Could not parse Node version '$node_version'."
fi

if [ "$node_major" -lt "$min_major" ] ||
   { [ "$node_major" -eq "$min_major" ] && [ "$node_minor" -lt "$min_minor" ]; }; then
  die "Node $node_version is older than the required $min_major.$min_minor."
fi

# --- 1. Find Wrangler --------------------------------------------------------

find_wrangler ||
  die "wrangler was not found (looked in '$TARGET_DIR/node_modules/.bin', '$TARGET_DIR/apps/api/node_modules/.bin' and PATH). Run install_webapp_dependencies.sh first."

say "Wrangler dependency is installed: $WRANGLER_BIN"

# --- 2. Verify that Wrangler runs --------------------------------------------

if ! wrangler_version="$("$WRANGLER_BIN" --version 2>&1)"; then
  die "wrangler was found at '$WRANGLER_BIN' but failed to run: $wrangler_version"
fi
say "Using wrangler at '$WRANGLER_BIN': $wrangler_version"

say "Cloudflare Wrangler dependency verification complete."
say "Next, from inside '$TARGET_DIR': npx wrangler login"
